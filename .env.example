# Puerto del servidor
PORT=3000

# Node environment
NODE_ENV=production

# API Key para autenticación (genera una clave segura de 32+ caracteres)
# Genera una con: openssl rand -base64 32
API_KEY=cambiar-esta-clave-por-una-segura-de-32-caracteres-minimo

# Orígenes permitidos para CORS (separados por coma)
# Desarrollo: usa *
# Producción: específica los dominios exactos
ALLOWED_ORIGINS=*

# Connection string de PostgreSQL (opcional, se puede pasar desde Claude)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_db
